# Optional canonical production URL override. On Vercel, the project's production domain is used automatically when system environment variables are exposed.
NEXT_PUBLIC_SITE_URL=

# Published CSV URLs for each menu tab (server-side only). Spanish is the source of truth.
MENU_SHEET_CSV_URL_ES=
MENU_SHEET_CSV_URL_EN=
MENU_SHEET_CSV_URL_CA=
MENU_SHEET_CSV_URL_FR=
MENU_SHEET_CSV_URL_RU=

# Protected menu editor (/admin). Server-only; never NEXT_PUBLIC_.
NEXTAUTH_URL=http://localhost:3001
# Generate a unique random secret of at least 32 characters.
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact Google email addresses, separated by commas. Empty means no access.
MENU_ADMIN_ALLOWED_EMAILS=
MENU_SPREADSHEET_ID=18Ijk5iJ5znSgPBJ-xqWyUtGpfv207LZwg1OXalKcADA
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Use the JSON key's private_key value, with escaped newlines (\n).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# VIP loyalty: server-only, Vercel Production only. Use emulator locally.
LOYALTY_FIREBASE_PROJECT_ID=
LOYALTY_FIREBASE_CLIENT_EMAIL=
LOYALTY_FIREBASE_PRIVATE_KEY=
